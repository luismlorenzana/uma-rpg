# Production build config for the SPA. Firebase web values are PUBLIC client config (safe to ship in the bundle); real
# security is the API's Firebase-token guard + owner email allowlist. The API is same-origin (/api via Hosting rewrite).
# Use the Hosting domain so the auth handler is same-origin inside the iOS Home Screen app (as uma-racer does).
VITE_FIREBASE_AUTH_DOMAIN=uma-rpg.web.app
VITE_FIREBASE_PROJECT_ID=uma-rpg
VITE_FIREBASE_API_KEY=AIzaSyCysnRIbFgh4ILYIgwjs_rSgyoCnxYbJ2g
