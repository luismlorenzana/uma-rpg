{
  "name": "uma-rpg",
  "private": true,
  "version": "0.1.0",
  "description": "Personal Uma Musume-inspired party RPG — monorepo (web + api + domain).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "node --test scripts/check-size.test.mjs scripts/cast/*.test.mjs scripts/l2d/*.test.mjs && turbo run test",
    "cast:review": "node scripts/cast/review.mjs",
    "cast:install": "node scripts/cast/install-review.mjs",
    "cast:export": "node scripts/cast/export-crops.mjs",
    "l2d:download": "node scripts/l2d/download.mjs",
    "l2d:review": "node scripts/l2d/server.mjs",
    "web": "pnpm --filter @rpg/web dev",
    "api": "pnpm --filter @rpg/api dev",
    "docs:update": "pnpm --filter @rpg/domain run docs:update"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "turbo": "^2.10.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@nestjs/core",
      "protobufjs",
      "@firebase/util"
    ]
  }
}
